{
  "name": "idlescreen-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation app for idlescreen.codeswhat.com/docs. A static Next.js export that scripts/assemble.mjs copies into website/dist/docs.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "node scripts/sync-changelog.mjs && next build && node scripts/csp-meta.mjs",
    "assemble": "node scripts/assemble.mjs",
    "lint": "tsc --noEmit",
    "test:scripts": "node --test scripts/*.test.mjs",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "fumadocs-core": "^16.17.8",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-ui": "^16.17.8",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "postcss": "$postcss"
  }
}
